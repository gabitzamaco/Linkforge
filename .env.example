# API server port. Development proxy defaults to port 3000.
PORT=3000

# Listen only on this machine by default. Use 0.0.0.0 only for intentional network access.
HOST=127.0.0.1

# Neon pooled PostgreSQL URL, used only by the Express backend.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Direct PostgreSQL URL for schema migrations (no -pooler in the hostname).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional public origin used in generated short URLs.
# Change this to your HTTPS origin when deploying behind a proxy.
BASE_URL=http://127.0.0.1:3000
