{
  "name": "linkforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A React and Express URL shortener with Neon serverless Postgres storage.",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite frontend --config frontend/vite.config.js",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/src/server.ts",
    "build": "npm run typecheck && vite build frontend --config frontend/vite.config.js",
    "start": "node --env-file-if-exists=.env backend/src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:import:sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.ts",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test tests/*.test.ts",
    "test:frontend": "vitest run --config frontend/vitest.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}
