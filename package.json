{
  "name": "linkforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A React and Express URL shortener with persistent SQLite storage.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite frontend --config frontend/vite.config.js",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/src/server.js",
    "build": "vite build frontend --config frontend/vite.config.js",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  }
}
